# Supply OPENAI_API_KEY through your credential manager or process environment.
# Never put a real key in a committed file or command-line argument.
ROUTER_PROVIDER=fixture
# Paid classification additionally needs an absolute ledger path in a private directory:
# ROUTER_PROVIDER=decisions
# ROUTER_LEDGER_PATH=/absolute/private-state/routing-ledger.json
# ROUTER_CONFIG_PATH=/absolute/private-config/router.json

# Recommendation candidate arrays are JSON STRINGS in the process environment.
APTLY_CLAUDE_MODELS='["haiku","sonnet","opus"]'
APTLY_CODEX_MODELS='["gpt-6-luna","gpt-6.1-terra","gpt-6.1-sol"]'
# [] disables that client. Unset uses the three defaults; malformed/unknown values fail.
# CLAUDE_MODELS and CODEX_MODELS are aliases; do not set both naming forms.
# Optional private normalized official-model cache; read at process startup, TTL 7 days:
# APTLY_MODEL_INFO_PATH=/absolute/private-state/model-info.json
# Refresh explicitly with: aptly catalog refresh --output /absolute/private-state/model-info.json

# Local per-ledger budget defaults (not OpenAI billing limits).
# Zero ceilings mean unlimited; the per-attempt reservation must stay positive.
APTLY_MAX_DAILY_CALLS=200
APTLY_MAX_TOTAL_CALLS=0
APTLY_MAX_ESTIMATED_USD=0
APTLY_ESTIMATED_CALL_USD=0.002
# MCP restart required after changing host settings. This file is not auto-loaded.
