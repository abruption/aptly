+//! Bounded observations of child configuration merge stages.
+//!
+//! These labels are not complete host evidence or an authorization decision.
+//! Captured-step labels deliberately do not infer the underlying settings layers.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SettingSource {
+    CapturedStep,
+    ExplicitSpawn,
+    SubagentDefault,
+    ModelDefault,
+    Role,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RoleSource {
+    BuiltIn,
+    ConfiguredFile,
+}
+
+// No Debug/Serialize implementation: the digest stays in the host's internal trace.
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct RoleProvenance {
+    pub(crate) source: RoleSource,
+    pub(crate) sha256: String,
+    pub(crate) model_present: bool,
+    pub(crate) effort_present: bool,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct SpawnProvenance {
+    pub(crate) model: SettingSource,
+    pub(crate) effort: SettingSource,
+    pub(crate) role: Option<RoleProvenance>,
+}
+
+impl SpawnProvenance {
+    pub(crate) fn captured() -> Self {
+        Self {
+            model: SettingSource::CapturedStep,
+            effort: SettingSource::CapturedStep,
+            role: None,
+        }
+    }
+
+    pub(crate) fn apply_role(&mut self, role: Option<RoleProvenance>) {
+        if let Some(role) = role.as_ref() {
+            // Presence matters even when a role writes the same effective value.
+            if role.model_present {
+                self.model = SettingSource::Role;
+            }
+            if role.effort_present {
+                self.effort = SettingSource::Role;
+            }
+        }
+        self.role = role;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn captured_labels_do_not_infer_underlying_layers() {
+        let trace = SpawnProvenance::captured();
+        assert_eq!(trace.model, SettingSource::CapturedStep);
+        assert_eq!(trace.effort, SettingSource::CapturedStep);
+        assert!(trace.role.is_none());
+    }
+
+    #[test]
+    fn role_presence_overrides_each_field_independently() {
+        for (model_present, effort_present) in
+            [(false, false), (true, false), (false, true), (true, true)]
+        {
+            let mut trace = SpawnProvenance::captured();
+            trace.model = SettingSource::ExplicitSpawn;
+            trace.effort = SettingSource::ModelDefault;
+            trace.apply_role(Some(RoleProvenance {
+                source: RoleSource::ConfiguredFile,
+                sha256: "fixture-digest".into(),
+                model_present,
+                effort_present,
+            }));
+            assert_eq!(
+                trace.model,
+                if model_present {
+                    SettingSource::Role
+                } else {
+                    SettingSource::ExplicitSpawn
+                }
+            );
+            assert_eq!(
+                trace.effort,
+                if effort_present {
+                    SettingSource::Role
+                } else {
+                    SettingSource::ModelDefault
+                }
+            );
+            assert_eq!(
+                trace.role.as_ref().map(|role| role.model_present),
+                Some(model_present)
+            );
+        }
+    }
+
+    #[test]
+    fn role_without_a_file_leaves_merge_origins_unchanged() {
+        let mut trace = SpawnProvenance::captured();
+        trace.effort = SettingSource::SubagentDefault;
+        trace.apply_role(None);
+        assert_eq!(trace.model, SettingSource::CapturedStep);
+        assert_eq!(trace.effort, SettingSource::SubagentDefault);
+        assert!(trace.role.is_none());
+    }
+}
